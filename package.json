{
  "name": "draftroom",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local markdown editor with AI review perspectives that never write the text",
  "scripts": {
    "dev": "concurrently -k \"tsx watch server/index.ts --dev\" \"vite\"",
    "build": "vite build",
    "start": "vite build --logLevel warn && tsx server/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "smoke": "tsx scripts/smoke.ts",
    "publish:public": "tsx release/publish.ts"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@lezer/highlight": "^1.2.5",
    "@lezer/markdown": "^1.7.2",
    "ajv": "^8.20.0",
    "chokidar": "^5.0.0",
    "citeproc": "^2.4.63",
    "codemirror": "^6.0.2",
    "diff-match-patch": "^1.0.5",
    "jszip": "^3.10.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/diff-match-patch": "^1.0.36",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^4.1.11"
  }
}
